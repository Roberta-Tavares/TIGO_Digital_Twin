<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="tigo">
    <pose>4.2 2.5 0.2 0 0 -1.5708</pose>

    <!-- CHASSI -->
    <link name="base_link">
      <inertial>
        <mass>3.0</mass>
        <inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.04</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.30 0.30 0.10</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <!-- Se o seu STL estiver na pasta, ele usará. Se não, comente a linha mesh e descomente a box -->
          <!-- <box><size>0.30 0.30 0.10</size></box> -->
          <mesh>
            <uri>file:///home/betinha/ws_gap/src/tigo_gazebo/models/meshes/Tigo_para_gazebo.stl</uri>
            <scale>0.001 0.001 0.001</scale> 
          </mesh> 
       </geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient></material>
      </visual>

      <!-- CÂMERA DE PROFUNDIDADE HP60C VIRTUAL -->
      <sensor name="ascamera_hp60c" type="depth_camera">
        <pose>0.15 0 0.05 0 0 0</pose>
        <update_rate>15</update_rate>
        <always_on>true</always_on>
        <topic>/ascamera_hp60c/camera_publisher/depth0/image_raw</topic>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image><width>640</width><height>480</height><format>R_FLOAT32</format></image>
          <clip><near>0.10</near><far>10.0</far></clip>
        </camera>
      </sensor>
    </link>

    <!-- PLUGIN DE CONTROLE MECANUM -->
    <plugin filename="ignition-gazebo-mecanum-drive-system" name="ignition::gazebo::systems::MecanumDrive">
      <front_left_joint>fl_joint</front_left_joint>
      <front_right_joint>fr_joint</front_right_joint>
      <back_left_joint>rl_joint</back_left_joint>
      <back_right_joint>rr_joint</back_right_joint>
      <wheel_separation>0.212</wheel_separation>
      <wheelbase>0.164</wheelbase>
      <wheel_radius>0.041</wheel_radius>
      <odom_publish_frequency>20</odom_publish_frequency>
      <topic>/cmd_vel</topic>
    </plugin>
  </model>
</sdf>
